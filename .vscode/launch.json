{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Policy: MongoDB",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/policy",
      "cwd": "${workspaceFolder}",
      "env": {
        "HTTP_HOST": "127.0.0.1",
        "HTTP_PORT": "8080",
        "METRICS_ADDR": ":2112",
        "LOG_LEVEL": "DEBUG",
        "EXTERNAL_HTTP_ADDR": "http://localhost:8080",
        "MONGO_ADDR": "mongodb://localhost:27017/policy",
        "MONGO_DBNAME": "policy",
        "MONGO_COLLECTION": "policies",
        "MONGO_AUTH_MECHANISM": "SCRAM-SHA-1",
        "NATS_ADDR": "nats://localhost:4222",
        "NATS_SUBJECT": "policy_notifier",
        "CACHE_ADDR": "http://localhost:8082",
        "TASK_ADDR": "http://localhost:8083",
        "DID_RESOLVER_ADDR": "http://localhost:8084",
        "SIGNER_ADDR": "http://localhost:8085",
        "OCM_ADDR": "https://gaiax.vereign.com/ocm",
        "AUTH_ENABLED": "false",
        "IP_FILTER_ENABLE": "false"
      }
    },
    {
      "name": "Policy: Policy Repository",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/policy",
      "cwd": "${workspaceFolder}",
      "env": {
        "HTTP_HOST": "127.0.0.1",
        "HTTP_PORT": "8080",
        "METRICS_ADDR": ":2112",
        "LOG_LEVEL": "DEBUG",
        "EXTERNAL_HTTP_ADDR": "http://localhost:8080",
        "POLICY_REPOSITORY_CLONE_URL":"https://github.com/eclipse-xfsc/rego-policies.git",
        "POLICY_REPOSITORY_BRANCH": "main",
        "POLICY_REPOSITORY_FOLDER": "example",
        "POLICY_LOCK_ON_VALIDATION_FAILURE": "false",
        "NATS_URL": "nats://localhost:4222",
        "NATS_SUBJECT": "policy_notifier",
        "CACHE_ADDR": "http://localhost:8082",
        "TASK_ADDR": "http://localhost:8083",
        "DID_RESOLVER": "http://localhost:8084",
        "SIGNER_SIGN_URL": "http://localhost:8085",
        "OCM_ADDR": "http://ocm:8080",
        "AUTH_ENABLED": "false",
        "IP_FILTER_ENABLE": "false"
      }
    }
  ]
}
